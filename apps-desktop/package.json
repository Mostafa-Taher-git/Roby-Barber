{
  "name": "roby-barber-desktop",
  "version": "0.1.0",
  "description": "Roby Barber — Windows desktop (Electron + React + SQLite). Phase 1 foundation.",
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.main.json && electron .",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "npm --prefix src-renderer run build",
    "rebuild:native": "npx @electron/rebuild -v 33.4.11 -f -w better-sqlite3",
    "seed": "npm run rebuild:native && electron -r tsx/cjs scripts/run-seed.cjs",
    "smoke": "npm run rebuild:native && electron -r tsx/cjs scripts/run-tests.cjs",
    "inspect-db": "npm run rebuild:native && electron -r tsx/cjs scripts/inspect-db.cjs",
    "build": "npm run build:renderer && npm run build:main && npm run smoke"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.30.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.robybarber.desktop",
    "productName": "Roby Barber",
    "files": [
      "dist-main/**",
      "src-renderer/dist/**",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RobyBarber-Setup-${version}.exe",
      "shortcutName": "روبي باربر",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
